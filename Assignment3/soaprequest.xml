    <soap:Header>
        <pay:Credentials>
            <pay:clientId>campuseats-prod</pay:clientId>
            <pay:apiKey>REDACTED-API-KEY</pay:apiKey>
        </pay:Credentials>
    </soap:Header>

    <soap:Body>
        <pay:ChargeRequest>
            <pay:orderId>ORD-2026-00125</pay:orderId>
            <pay:amount>249.50</pay:amount>
